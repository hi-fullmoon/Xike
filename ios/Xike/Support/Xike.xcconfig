PRODUCT_NAME = Xike
PRODUCT_BUNDLE_IDENTIFIER = com.xike.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
ARCHS = arm64
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = NO
INFOPLIST_FILE = Xike/Support/Info.plist
SWIFT_OBJC_BRIDGING_HEADER = Xike/Support/Bridging.h
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) SQLITE_HAS_CODEC=1
OTHER_CFLAGS = $(inherited) -DSQLITE_HAS_CODEC
OTHER_LDFLAGS = $(inherited) -framework XikeNative
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -framework XikeNative -ObjC -framework AMapLocationKit -framework AMapFoundationKit -framework CoreTelephony -framework SystemConfiguration -framework ExternalAccessory -lz -lc++
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
XIKE_NATIVE_DIR[sdk=iphonesimulator*] = $(PROJECT_DIR)/build/native-simulator
XIKE_NATIVE_DIR[sdk=iphoneos*] = $(PROJECT_DIR)/build/native-device
FRAMEWORK_SEARCH_PATHS = $(inherited) $(XIKE_NATIVE_DIR)
FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(XIKE_NATIVE_DIR) $(PROJECT_DIR)/build/amap
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
