<resources>
    <style name="Theme.Xike.Picker" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:datePickerStyle">@style/Widget.Xike.DatePicker</item>
        <item name="android:timePickerStyle">@style/Widget.Xike.TimePicker</item>
    </style>
    <style name="Widget.Xike.DatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">?android:attr/colorPrimary</item>
    </style>
    <style name="Widget.Xike.TimePicker" parent="android:style/Widget.Material.TimePicker">
        <item name="android:headerBackground">?android:attr/colorPrimary</item>
    </style>
    <style name="PickerAccent.Pine"><item name="android:colorAccent">#E4ECD9</item><item name="android:colorPrimary">#496738</item></style>
    <style name="PickerAccent.Violet"><item name="android:colorAccent">#EAE3F0</item><item name="android:colorPrimary">#66567E</item></style>
    <style name="PickerAccent.Ocean"><item name="android:colorAccent">#DFECE8</item><item name="android:colorPrimary">#355E5B</item></style>
    <style name="PickerAccent.Terra"><item name="android:colorAccent">#F2E3DC</item><item name="android:colorPrimary">#925B49</item></style>
    <style name="PickerAccent.Amber"><item name="android:colorAccent">#F4E8C8</item><item name="android:colorPrimary">#82611E</item></style>
    <style name="PickerAccent.Rose"><item name="android:colorAccent">#F3E0E4</item><item name="android:colorPrimary">#8B5360</item></style>
    <style name="PickerSurface.Breathe"><item name="android:colorBackground">#1B211E</item></style>
    <style name="PickerSurface.Paper"><item name="android:colorBackground">#242019</item></style>
    <style name="PickerSurface.Focus"><item name="android:colorBackground">#1A1E1C</item></style>
</resources>
